<Window x:Class="StudyPlannerSystem.MyProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Progress" Height="250" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="My Progress" FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Student: " FontWeight="Bold"/>
            <TextBlock x:Name="txtStudentName"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Completed Tasks: " FontWeight="Bold"/>
            <TextBlock x:Name="txtCompletedCount"/>
            <TextBlock Text=" / "/>
            <TextBlock x:Name="txtTotalCount"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Completion Rate: " FontWeight="Bold"/>
            <TextBlock x:Name="txtCompletionRate"/>
        </StackPanel>

        <Button Grid.Row="8" Content="Close" Width="80" Height="30"
                HorizontalAlignment="Center" Click="BtnClose_Click"/>
    </Grid>
</Window>
