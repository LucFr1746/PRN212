<Window x:Class="StudyPlannerSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Study Planner - Main" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Study Tasks" Click="MenuStudyTasks_Click"/>
            <MenuItem Header="Subjects" Click="MenuSubjects_Click"/>
            <MenuItem Header="My Progress" Click="MenuMyProgress_Click"/>
            <MenuItem Header="Logout" Click="MenuLogout_Click"/>
        </Menu>

        <Grid x:Name="MainContent" Margin="10">
            <TextBlock Text="Welcome to Study Planner Management System"
                       FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DockPanel>
</Window>
