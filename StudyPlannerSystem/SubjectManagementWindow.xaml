<Window x:Class="StudyPlannerSystem.SubjectManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subject Management" Height="450" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Subject Management" FontSize="16" FontWeight="Bold"/>

        <DataGrid Grid.Row="2" x:Name="dgSubjects" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="DgSubjects_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Subject ID" Binding="{Binding SubjectId}" Width="80"/>
                <DataGridTextColumn Header="Subject Code" Binding="{Binding SubjectCode}" Width="120"/>
                <DataGridTextColumn Header="Subject Name" Binding="{Binding SubjectName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Subject Code:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="2" x:Name="txtSubjectCode" Height="25"/>

            <TextBlock Grid.Column="4" Text="Subject Name:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="6" x:Name="txtSubjectName" Height="25"/>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Add" Width="80" Height="30" Margin="5" Click="BtnAdd_Click"/>
            <Button Content="Edit" Width="80" Height="30" Margin="5" Click="BtnEdit_Click"/>
            <Button Content="Delete" Width="80" Height="30" Margin="5" Click="BtnDelete_Click"/>
            <Button Content="Clear" Width="80" Height="30" Margin="5" Click="BtnClear_Click"/>
        </StackPanel>
    </Grid>
</Window>
