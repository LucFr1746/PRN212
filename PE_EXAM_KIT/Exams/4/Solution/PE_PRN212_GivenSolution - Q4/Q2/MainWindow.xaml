<Window x:Class="Q2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee and Skills Management" Height="650" Width="850" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- 1. Filter Area (Auto height) -->
            <RowDefinition Height="Auto"/>
            <!-- 2. DataGrid List Area (Stretches) -->
            <RowDefinition Height="*"/>
            <!-- 3. Form Input / CRUD Area (Auto height) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======================================================= -->
        <!-- ZONE 1: FILTER AREA -->
        <!-- ======================================================= -->
        <GroupBox Header="Filters" Grid.Row="0" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Department:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="cboFilterDepartment" Width="150" Margin="0,0,15,0"/>

                <TextBlock Text="Skill:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="cboFilterSkill" Width="150" Margin="0,0,15,0"/>

                <Button Content="Filter" Click="FilterButton_Click" Width="80" Margin="0,0,5,0" Background="#10B981" Foreground="White" FontWeight="Bold"/>
                <Button Content="Clear" Click="ClearFilterButton_Click" Width="80" Background="#6B7280" Foreground="White"/>
            </StackPanel>
        </GroupBox>

        <!-- ======================================================= -->
        <!-- ZONE 2: DATA GRID LIST -->
        <!-- ======================================================= -->
        <GroupBox Header="Employee List" Grid.Row="1" Margin="0,0,0,10">
            <DataGrid x:Name="dgEmployees" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="DgRecords_SelectionChanged" AlternatingRowBackground="#F9FAFB" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="EmployeeId" Binding="{Binding EmployeeId}" Width="75"/>
                    <DataGridTextColumn Header="FullName" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                    <DataGridTextColumn Header="Salary" Binding="{Binding Salary, StringFormat={}{0:N2}}" Width="120"/>
                    <DataGridTextColumn Header="HireDate" Binding="{Binding HireDate}" Width="*"/>
                    <DataGridTextColumn Header="Department Name" Binding="{Binding Department.DepartmentName}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- ======================================================= -->
        <!-- ZONE 3: CRUD / INSERT FORM -->
        <!-- ======================================================= -->
        <GroupBox Header="Add New / Details" Grid.Row="2" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Primary Fields -->
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,0">
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="FullName:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtFullName" Grid.Column="1" Padding="3"/>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Email:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtEmail" Grid.Column="1" Padding="3"/>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Salary:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtSalary" Grid.Column="1" Padding="3"/>
                    </Grid>

                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Department Name:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cboDepartment" Grid.Column="1" Padding="3"/>
                    </Grid>
                </StackPanel>

                <!-- Right Column: Checkbox List (Many-to-Many Bridge) -->
                <Grid Grid.Column="1" Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Skills:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ListBox x:Name="lstSkills" Grid.Row="1" Height="100" SelectionMode="Multiple">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding SkillName}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Lower Command Row -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="Save / Add" Click="SaveButton_Click" Width="100" Margin="0,0,5,0" Padding="5" Background="#2563EB" Foreground="White" FontWeight="Bold"/>
                    <Button Content="Reset Form" Click="ResetButton_Click" Width="100" Padding="5" Background="#9CA3AF" Foreground="White"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
