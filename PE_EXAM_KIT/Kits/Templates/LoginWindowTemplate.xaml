<Window x:Class="PRN212.ExamKit.Templates.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Login" Height="250" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#F3F4F6">
        <StackPanel VerticalAlignment="Center" Margin="30">
            <!-- Header -->
            <TextBlock Text="SYSTEM LOGIN" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center" Foreground="#1F2937"/>
            
            <!-- Username Input -->
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Username:" VerticalAlignment="Center" Foreground="#374151" FontSize="13"/>
                <TextBox x:Name="txtUsername" Grid.Column="1" Padding="5" FontSize="13" VerticalContentAlignment="Center"/>
            </Grid>

            <!-- Password Input -->
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Password:" VerticalAlignment="Center" Foreground="#374151" FontSize="13"/>
                <PasswordBox x:Name="txtPassword" Grid.Column="1" Padding="5" FontSize="13" VerticalContentAlignment="Center"/>
            </Grid>

            <!-- Action Button -->
            <Button Content="Login" Click="LoginButton_Click" Margin="0,20,0,0" Padding="8" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
